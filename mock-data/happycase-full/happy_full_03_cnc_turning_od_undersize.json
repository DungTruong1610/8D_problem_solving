  "fiveWhyChain": [
    {
      "stepNo": 1,
      "question": "Why were the shafts below the lower diameter tolerance?",
      "answer": "Outer diameter measured 24.918mm against 24.950-25.000mm on parts turned on L1",
      "evidenceCitation": "Inspection lot QALS/QAMR"
    },
    {
      "stepNo": 2,
      "question": "Why did L1 cut undersize after the insert change?",
      "answer": "The CNC kept the wear offset of the previous insert, so the new insert cut too deep",
      "evidenceCitation": "CNC offset table WC-TURN-02-L1"
    },
    {
      "stepNo": 3,
      "question": "Why was the wear offset not reset? (root cause)",
      "answer": "DOC-4410 has no offset reset step and the controller does not prompt for it",
      "evidenceCitation": "DOC-4410 Rev B"
    }
  ],
