  "fiveWhyChain": [
    {
      "stepNo": 1,
      "question": "Why did the sensor mounts detach?",
      "answer": "Lap shear strength measured 4.6 MPa against a 12.0 MPa minimum on brackets bonded with DISPENSER1",
      "evidenceCitation": "Inspection lot QALS/QAMR"
    },
    {
      "stepNo": 2,
      "question": "Why was the bond weak only on DISPENSER1 parts?",
      "answer": "DISPENSER1 mixes resin and hardener at 1.28:1 instead of 1:1, so the adhesive does not fully cure",
      "evidenceCitation": "Mix ratio check WC-BOND-02-DISPENSER1"
    },
    {
      "stepNo": 3,
      "question": "Why does DISPENSER1 mix off-ratio? (root cause)",
      "answer": "The hardener metering pump is worn and the mix ratio is not checked at cartridge change",
      "evidenceCitation": "SAP PM order history WC-BOND-02"
    }
  ],
