  "fiveWhyChain": [
    {
      "stepNo": 1,
      "question": "Why did the bezel frames show pitting?",
      "answer": "Up to 9 pits per frame against zero allowed, all on frames rinsed in tank 3",
      "evidenceCitation": "Inspection lot QALS/QAMR"
    },
    {
      "stepNo": 2,
      "question": "Why did tank 3 rinsing cause pitting?",
      "answer": "Rinse water chloride reached 38 mg/l against max 5 mg/l because the ion exchange resin was exhausted",
      "evidenceCitation": "Lab analysis rinse tank 3"
    },
    {
      "stepNo": 3,
      "question": "Why was the exhausted resin not detected? (root cause)",
      "answer": "Conductivity probe CP-03 was fouled and read low, so the high-limit alarm never triggered",
      "evidenceCitation": "Probe check against reference meter"
    }
  ],
