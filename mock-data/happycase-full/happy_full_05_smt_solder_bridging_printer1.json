  "fiveWhyChain": [
    {
      "stepNo": 1,
      "question": "Why did solder bridges form on the QFN pins?",
      "answer": "Solder paste volume was 161% against 80-120%, so neighbouring pads merged in reflow",
      "evidenceCitation": "SPI record QALS/QAMR"
    },
    {
      "stepNo": 2,
      "question": "Why was paste volume too high only on PRINTER1?",
      "answer": "Paste built up under the stencil because the understencil wipe did not remove it",
      "evidenceCitation": "SPI trend WC-SMT-02-PRINTER1"
    },
    {
      "stepNo": 3,
      "question": "Why did the understencil wipe fail? (root cause)",
      "answer": "The wipe vacuum filter is clogged, vacuum fell to 9 kPa, and no PM task covers the filter",
      "evidenceCitation": "SAP PM order history WC-SMT-02"
    }
  ],
