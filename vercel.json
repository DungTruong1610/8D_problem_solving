{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd app/8D_hackathon_ui && npm install",
  "buildCommand": "cd app/8D_hackathon_ui && npm run build",
  "outputDirectory": "app/8D_hackathon_ui/dist",
  "rewrites": [
    {
      "source": "/((?!api/|odata/|workflow/|workflow-admin/|identity/|identity-admin/).*)",
      "destination": "/index.html"
    }
  ]
}
