# ═══════════════════════════════════════════════════════════════════════════════
#  CẤU HÌNH DỰ ÁN 8D HACKATHON (CNMA PRORESOLVE)
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
#  1. CẤU HÌNH AI (Chọn 1 trong 2 cách dưới đây)
# ─────────────────────────────────────────────────────────────────────────────

# --- CÁCH A: DÙNG GOOGLE GEMINI (Khuyến nghị - Nhanh, Thông minh, Miễn phí) ---
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- CÁCH B: DÙNG LOCAL LLM (Tự Host Qwen 2.5/3.5 qua Ollama hoặc LM Studio) ---
# Nếu muốn chạy offline 100% không tốn token mạng:
# 1. Bật Ollama: ollama run qwen2.5:3b (hoặc tải Qwen trên LM Studio)
# 2. Bỏ comment các dòng dưới đây:
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:3b
# LOCAL_LLM_KEY=ollama

# ─────────────────────────────────────────────────────────────────────────────
#  2. CƠ SỞ DỮ LIỆU (DATABASE CONFIGURATION)
# ─────────────────────────────────────────────────────────────────────────────
# Mặc định: Dùng SQLite (file db.sqlite trong thư mục dự án) — KHÔNG CẦN DOCKER!
# Nếu muốn chạy PostgreSQL 16 + pgvector container thì mới cần Docker:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=proresolve
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─────────────────────────────────────────────────────────────────────────────
#  3. CHẾ ĐỘ MOCK AI (Test nhanh không gọi model)
# ─────────────────────────────────────────────────────────────────────────────
MOCK_LLM=false
