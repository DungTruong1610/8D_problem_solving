# ═══════════════════════════════════════════════════════════════════════════════
#  CẤU HÌNH DỰ ÁN 8D HACKATHON (CNMA PRORESOLVE)
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
#  1. CHAT MODEL — chọn 1 trong 3 cách
# ─────────────────────────────────────────────────────────────────────────────

# --- CÁCH A1 (KHUYẾN NGHỊ): DEEPSEEK CHÍNH HÃNG (Official Platform API) ---
# Key lấy tại: https://platform.deepseek.com
# Model chính hãng: deepseek-flash (DeepSeek V4.1 Flash), fallback: deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Model mặc định cho từng bước khi dùng DeepSeek chính hãng
AICORE_DEFAULT_MODEL=deepseek-flash
AICORE_MODEL_PARSE=deepseek-flash
AICORE_MODEL_STRUCTURE=deepseek-flash
AICORE_MODEL_ANALYZE=deepseek-flash
AICORE_MODEL_ANALYZE_FALLBACK=deepseek-v4-pro

# --- CÁCH A2: DEEPSEEK QUA OPENCODE GO / ZEN ---
# Dùng credit OpenCode Go / Zen: https://opencode.ai/auth
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
# DEEPSEEK_MODEL=deepseek-v4.1-flash
# AICORE_DEFAULT_MODEL=deepseek-v4.1-flash
# AICORE_MODEL_PARSE=deepseek-v4.1-flash
# AICORE_MODEL_STRUCTURE=deepseek-v4.1-flash
# AICORE_MODEL_ANALYZE=deepseek-v4.1-flash
# AICORE_MODEL_ANALYZE_FALLBACK=deepseek-v4-pro

# Mặc định app TẮT thinking mode cho DeepSeek (nhanh, tôn trọng temperature).
# Bật lại cho các bước cần suy luận sâu: DEEPSEEK_THINKING=on
# DEEPSEEK_THINKING=on
# DEEPSEEK_REASONING_EFFORT=high        # low | high | max

# --- EMBEDDING (BẮT BUỘC NẾU MUỐN TIÊU CHÍ NGỮ NGHĨA) ---
# DeepSeek không có API embedding. Jina AI có free tier, endpoint chuẩn OpenAI.
# Lấy key tại https://jina.ai/embeddings/ → API Key.
JINA_API_KEY=
# EMBEDDING_MODEL=jina-embeddings-v5-text-small
# Đổi sang nhà cung cấp khác (Mistral, OpenAI, LM Studio…) thì khai tường minh:
# EMBEDDING_BASE_URL=https://api.mistral.ai/v1
# EMBEDDING_API_KEY=...
# EMBEDDING_MODEL=mistral-embed
# Tắt hẳn embedding (tiêu chí ngữ nghĩa sẽ bị bỏ qua): EMBEDDINGS_DISABLED=true

# --- CÁCH B: GOOGLE GEMINI (vẫn dùng được, chỉ cần khi không dùng DeepSeek) ---
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- CÁCH C: LOCAL LLM (Ollama / LM Studio / vLLM) ---
# 1. Bật Ollama: ollama run qwen2.5:3b
# 2. Bỏ comment các dòng dưới đây:
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:3b
# LOCAL_LLM_KEY=ollama

# ─────────────────────────────────────────────────────────────────────────────
#  2. CƠ SỞ DỮ LIỆU (DATABASE CONFIGURATION)
# ─────────────────────────────────────────────────────────────────────────────
# Mặc định: SQLite (file db.sqlite trong thư mục dự án) — KHÔNG CẦN DOCKER!
# Nếu muốn chạy PostgreSQL 16 + pgvector container thì mới cần Docker:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=proresolve
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─────────────────────────────────────────────────────────────────────────────
#  3. CHẾ ĐỘ MOCK AI (Test nhanh không gọi model)
# ─────────────────────────────────────────────────────────────────────────────
MOCK_LLM=false
