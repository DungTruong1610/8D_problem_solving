VIEW "GRAPH_V_MATERIALFAMILY" AS
SELECT DISTINCT
    CAST('FAM:' || "FAM" AS NVARCHAR(150)) AS "NODE_ID",
    CAST("FAM" AS NVARCHAR(30)) AS "BIZ_KEY"
FROM (
    SELECT "MATERIALFAMILY" AS "FAM" FROM "CNMA_PRORESOLVE_HISTORICALCASES" WHERE "MATERIALFAMILY" IS NOT NULL
    UNION ALL
    SELECT "MATERIALGROUP"  AS "FAM" FROM "CNMA_PRORESOLVE_DEFECTS" WHERE "MATERIALGROUP" IS NOT NULL
) AS "SRC"
