VIEW "GRAPH_V_ACTION" AS
SELECT
    CAST('ACT:' || "ID" AS NVARCHAR(150)) AS "NODE_ID",
    CAST("ID" AS NVARCHAR(36)) AS "BIZ_KEY",
    CAST("ACTIONTEXT" AS NVARCHAR(1000)) AS "TITLE",
    CAST("ACTIONTYPE" AS NVARCHAR(30)) AS "ACTION_TYPE",
    CAST("STATUS" AS NVARCHAR(30)) AS "ACTION_STATUS",
    CAST(IFNULL("TIMEEFFORT", 0) AS DOUBLE) AS "TIME_EFFORT"
FROM "CNMA_PRORESOLVE_HISTORICALACTIONS"
WHERE "ID" IS NOT NULL
