VIEW "GRAPH_V_INSPECTIONLOT" AS
SELECT
    CAST('LOT:' || "LOTID" || '#' || "CHARACTERISTIC" AS NVARCHAR(150)) AS "NODE_ID",
    CAST("LOTID" AS NVARCHAR(30)) AS "BIZ_KEY",
    CAST("CHARACTERISTIC" AS NVARCHAR(120)) AS "CHARACTERISTIC",
    CAST("MEASUREDVALUE" AS NVARCHAR(60)) AS "MEASURED",
    CAST(CASE WHEN "CONFORMING" = TRUE THEN 'Y' ELSE 'N' END AS NVARCHAR(1)) AS "CONFORMING",
    CAST(TO_VARCHAR("LOTDATE", 'YYYY-MM-DD') AS NVARCHAR(10)) AS "LOT_DATE"
FROM "CNMA_PRORESOLVE_INSPECTIONLOTS"
WHERE "LOTID" IS NOT NULL AND "CHARACTERISTIC" IS NOT NULL
