VIEW "GRAPH_E_DEFECT_HAS_CODE" AS
SELECT
    CAST('DEFECT_HAS_CODE|' || "DEFECTID" AS NVARCHAR(150)) AS "EDGE_ID",
    CAST('OPENDEF:' || "DEFECTID" AS NVARCHAR(150)) AS "SOURCE_ID",
    CAST('DC:' || "DEFECTCODE" AS NVARCHAR(150)) AS "TARGET_ID"
FROM "CNMA_PRORESOLVE_DEFECTS"
WHERE "DEFECTID" IS NOT NULL AND "DEFECTCODE" IS NOT NULL
