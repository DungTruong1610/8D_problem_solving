VIEW "GRAPH_E_FMEA_COVERS_MAT" AS
SELECT DISTINCT
    CAST('COVERS_MATERIAL|' || "FMEAID" || '|' || "MATERIALID" AS NVARCHAR(150)) AS "EDGE_ID",
    CAST('FMEA:' || "FMEAID" AS NVARCHAR(150)) AS "SOURCE_ID",
    CAST('MAT:' || "MATERIALID" AS NVARCHAR(150)) AS "TARGET_ID"
FROM "CNMA_PRORESOLVE_FMEAREGISTER"
WHERE "FMEAID" IS NOT NULL AND "MATERIALID" IS NOT NULL
