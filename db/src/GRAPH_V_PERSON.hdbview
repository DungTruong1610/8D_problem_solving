VIEW "GRAPH_V_PERSON" AS
SELECT
    CAST('PER:' || "PARTNERID" AS NVARCHAR(150)) AS "NODE_ID",
    CAST("PARTNERID" AS NVARCHAR(30)) AS "BIZ_KEY",
    CAST(MAX("PARTNERNAME") AS NVARCHAR(100)) AS "TITLE",
    CAST(MAX("EMAIL") AS NVARCHAR(120)) AS "EMAIL"
FROM "CNMA_PRORESOLVE_HISTORICALTEAMMEMBERS"
WHERE "PARTNERID" IS NOT NULL
GROUP BY "PARTNERID"
