VIEW "GRAPH_E_DEFECT_ON_MATERIAL" AS
SELECT
    CAST('DEFECT_ON_MATERIAL|' || "DEFECTID" AS NVARCHAR(150)) AS "EDGE_ID",
    CAST('OPENDEF:' || "DEFECTID" AS NVARCHAR(150)) AS "SOURCE_ID",
    CAST('MAT:' || "MATERIALID" AS NVARCHAR(150)) AS "TARGET_ID"
FROM "CNMA_PRORESOLVE_DEFECTS"
WHERE "DEFECTID" IS NOT NULL AND "MATERIALID" IS NOT NULL
