VIEW "GRAPH_V_KEYWORD" AS
SELECT DISTINCT
    CAST('KW:' || "TOKEN" AS NVARCHAR(150)) AS "NODE_ID",
    CAST("TOKEN" AS NVARCHAR(60)) AS "BIZ_KEY"
FROM (
    SELECT SUBSTR_REGEXPR('[^ ]+' IN h."SEARCHKEYWORDS" OCCURRENCE s."GENERATED_PERIOD_START") AS "TOKEN"
    FROM "CNMA_PRORESOLVE_HISTORICALCASES" h
    CROSS JOIN SERIES_GENERATE_INTEGER(1, 1, 61) s
    WHERE h."SEARCHKEYWORDS" IS NOT NULL
      AND SUBSTR_REGEXPR('[^ ]+' IN h."SEARCHKEYWORDS" OCCURRENCE s."GENERATED_PERIOD_START") IS NOT NULL
) AS "SRC"
