VIEW "GRAPH_V_OPENDEFECT" AS
SELECT
    CAST('OPENDEF:' || "DEFECTID" AS NVARCHAR(150)) AS "NODE_ID",
    CAST("DEFECTID" AS NVARCHAR(30)) AS "BIZ_KEY",
    CAST("SYMPTOMSHORTTEXT" AS NVARCHAR(255)) AS "TITLE",
    CAST("STATUS" AS NVARCHAR(20)) AS "DEFECT_STATUS"
FROM "CNMA_PRORESOLVE_DEFECTS"
WHERE "DEFECTID" IS NOT NULL
