VIEW "GRAPH_E_ACTS_AS" AS
SELECT DISTINCT
    CAST('ACTS_AS|' || "PARTNERID" || '|' || "FUNCTIONTITLE" AS NVARCHAR(150)) AS "EDGE_ID",
    CAST('PER:' || "PARTNERID" AS NVARCHAR(150)) AS "SOURCE_ID",
    CAST('FUN:' || "FUNCTIONTITLE" AS NVARCHAR(150)) AS "TARGET_ID"
FROM "CNMA_PRORESOLVE_HISTORICALTEAMMEMBERS"
WHERE "PARTNERID" IS NOT NULL AND "FUNCTIONTITLE" IS NOT NULL
