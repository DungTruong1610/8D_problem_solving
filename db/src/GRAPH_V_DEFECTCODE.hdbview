VIEW "GRAPH_V_DEFECTCODE" AS
SELECT
    CAST('DC:' || "DEFECTCODE" AS NVARCHAR(150)) AS "NODE_ID",
    CAST("DEFECTCODE" AS NVARCHAR(30)) AS "BIZ_KEY",
    CAST(MAX("DESCR") AS NVARCHAR(255)) AS "TITLE",
    CAST(MAX("GRP") AS NVARCHAR(30)) AS "CODE_GROUP"
FROM (
    SELECT "DEFECTCODE", "DEFECTTEXT" AS "DESCR", "DEFECTCODEGROUP" AS "GRP" FROM "CNMA_PRORESOLVE_HISTORICALCASES" WHERE "DEFECTCODE" IS NOT NULL
    UNION ALL
    SELECT "DEFECTCODE", "DEFECTTEXT" AS "DESCR", "DEFECTCODEGROUP" AS "GRP" FROM "CNMA_PRORESOLVE_DEFECTS" WHERE "DEFECTCODE" IS NOT NULL
) AS "SRC"
GROUP BY "DEFECTCODE"
