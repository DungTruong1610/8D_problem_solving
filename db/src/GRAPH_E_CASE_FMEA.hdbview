VIEW "GRAPH_E_CASE_FMEA" AS
SELECT
    CAST('REFERENCES_FMEA|' || "NOTIFICATIONID" AS NVARCHAR(150)) AS "EDGE_ID",
    CAST('CASE:' || "NOTIFICATIONID" AS NVARCHAR(150)) AS "SOURCE_ID",
    CAST('FMEA:' || "FMEAID" AS NVARCHAR(150)) AS "TARGET_ID"
FROM "CNMA_PRORESOLVE_HISTORICALCASES"
WHERE "NOTIFICATIONID" IS NOT NULL AND "FMEAID" IS NOT NULL
