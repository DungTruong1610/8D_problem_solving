VIEW "GRAPH_E_IN_FAMILY" AS
SELECT DISTINCT
    CAST('IN_FAMILY|' || "MAT" || '|' || "FAM" AS NVARCHAR(150)) AS "EDGE_ID",
    CAST('MAT:' || "MAT" AS NVARCHAR(150)) AS "SOURCE_ID",
    CAST('FAM:' || "FAM" AS NVARCHAR(150)) AS "TARGET_ID"
FROM (
    SELECT "MATERIALID" AS "MAT", "MATERIALFAMILY" AS "FAM" FROM "CNMA_PRORESOLVE_HISTORICALCASES"
    WHERE "MATERIALID" IS NOT NULL AND "MATERIALFAMILY" IS NOT NULL
    UNION ALL
    SELECT "MATERIALID" AS "MAT", "MATERIALGROUP" AS "FAM" FROM "CNMA_PRORESOLVE_DEFECTS"
    WHERE "MATERIALID" IS NOT NULL AND "MATERIALGROUP" IS NOT NULL
) AS "SRC"
