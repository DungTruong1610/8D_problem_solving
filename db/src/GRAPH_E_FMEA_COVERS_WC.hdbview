VIEW "GRAPH_E_FMEA_COVERS_WC" AS
SELECT DISTINCT
    CAST('COVERS_WORKCENTER|' || "FMEAID" || '|' || "WORKCENTERID" AS NVARCHAR(150)) AS "EDGE_ID",
    CAST('FMEA:' || "FMEAID" AS NVARCHAR(150)) AS "SOURCE_ID",
    CAST('WC:' || "WORKCENTERID" AS NVARCHAR(150)) AS "TARGET_ID"
FROM "CNMA_PRORESOLVE_FMEAREGISTER"
WHERE "FMEAID" IS NOT NULL AND "WORKCENTERID" IS NOT NULL
