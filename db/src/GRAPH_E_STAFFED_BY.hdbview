VIEW "GRAPH_E_STAFFED_BY" AS
SELECT
    CAST('STAFFED_BY|' || t."ID" AS NVARCHAR(150)) AS "EDGE_ID",
    CAST('CASE:' || h."NOTIFICATIONID" AS NVARCHAR(150)) AS "SOURCE_ID",
    CAST('PER:' || t."PARTNERID" AS NVARCHAR(150)) AS "TARGET_ID",
    CAST(t."FUNCTIONTITLE" AS NVARCHAR(100)) AS "FUNCTION_TITLE",
    CAST(t."PARTNERROLE" AS NVARCHAR(50)) AS "PARTNER_ROLE"
FROM "CNMA_PRORESOLVE_HISTORICALTEAMMEMBERS" t
JOIN "CNMA_PRORESOLVE_HISTORICALCASES" h ON h."ID" = t."HISTORICALCASE_ID"
WHERE t."PARTNERID" IS NOT NULL AND h."NOTIFICATIONID" IS NOT NULL
