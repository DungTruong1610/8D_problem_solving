VIEW "GRAPH_V_WORKCENTER" AS
SELECT
    CAST('WC:' || "WORKCENTERID" AS NVARCHAR(150)) AS "NODE_ID",
    CAST("WORKCENTERID" AS NVARCHAR(30)) AS "BIZ_KEY",
    CAST(MAX("DESCR") AS NVARCHAR(255)) AS "TITLE"
FROM (
    SELECT "WORKCENTERID", "WORKCENTERDESC" AS "DESCR" FROM "CNMA_PRORESOLVE_HISTORICALCASES" WHERE "WORKCENTERID" IS NOT NULL
    UNION ALL
    SELECT "WORKCENTERID", "WORKCENTERDESC" AS "DESCR" FROM "CNMA_PRORESOLVE_DEFECTS" WHERE "WORKCENTERID" IS NOT NULL
    UNION ALL
    SELECT "WORKCENTERID", CAST(NULL AS NVARCHAR(255)) FROM "CNMA_PRORESOLVE_INSPECTIONLOTS" WHERE "WORKCENTERID" IS NOT NULL
    UNION ALL
    SELECT "WORKCENTERID", CAST(NULL AS NVARCHAR(255)) FROM "CNMA_PRORESOLVE_FMEAREGISTER" WHERE "WORKCENTERID" IS NOT NULL
) AS "SRC"
GROUP BY "WORKCENTERID"
