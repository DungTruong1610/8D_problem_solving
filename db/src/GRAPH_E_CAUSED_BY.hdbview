VIEW "GRAPH_E_CAUSED_BY" AS
SELECT
    CAST('CAUSED_BY|' || "NOTIFICATIONID" AS NVARCHAR(150)) AS "EDGE_ID",
    CAST('CASE:' || "NOTIFICATIONID" AS NVARCHAR(150)) AS "SOURCE_ID",
    CAST('RC:' || "ROOTCAUSECATEGORY" AS NVARCHAR(150)) AS "TARGET_ID"
FROM "CNMA_PRORESOLVE_HISTORICALCASES"
WHERE "NOTIFICATIONID" IS NOT NULL AND "ROOTCAUSECATEGORY" IS NOT NULL
