VIEW "GRAPH_V_MATERIAL" AS
SELECT
    CAST('MAT:' || "MATERIALID" AS NVARCHAR(150)) AS "NODE_ID",
    CAST("MATERIALID" AS NVARCHAR(30)) AS "BIZ_KEY",
    CAST(MAX("DESCR") AS NVARCHAR(255)) AS "TITLE"
FROM (
    SELECT "MATERIALID", "MATERIALDESC" AS "DESCR" FROM "CNMA_PRORESOLVE_HISTORICALCASES" WHERE "MATERIALID" IS NOT NULL
    UNION ALL
    SELECT "MATERIALID", "MATERIALDESC" AS "DESCR" FROM "CNMA_PRORESOLVE_DEFECTS" WHERE "MATERIALID" IS NOT NULL
    UNION ALL
    SELECT "MATERIALID", CAST(NULL AS NVARCHAR(255)) FROM "CNMA_PRORESOLVE_INSPECTIONLOTS" WHERE "MATERIALID" IS NOT NULL
    UNION ALL
    SELECT "MATERIALID", CAST(NULL AS NVARCHAR(255)) FROM "CNMA_PRORESOLVE_FMEAREGISTER" WHERE "MATERIALID" IS NOT NULL
) AS "SRC"
GROUP BY "MATERIALID"
