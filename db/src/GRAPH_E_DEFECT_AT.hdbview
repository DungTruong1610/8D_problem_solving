VIEW "GRAPH_E_DEFECT_AT" AS
SELECT
    CAST('DEFECT_AT|' || "DEFECTID" AS NVARCHAR(150)) AS "EDGE_ID",
    CAST('OPENDEF:' || "DEFECTID" AS NVARCHAR(150)) AS "SOURCE_ID",
    CAST('WC:' || "WORKCENTERID" AS NVARCHAR(150)) AS "TARGET_ID"
FROM "CNMA_PRORESOLVE_DEFECTS"
WHERE "DEFECTID" IS NOT NULL AND "WORKCENTERID" IS NOT NULL
