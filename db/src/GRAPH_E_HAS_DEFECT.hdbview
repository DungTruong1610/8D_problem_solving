VIEW "GRAPH_E_HAS_DEFECT" AS
SELECT
    CAST('HAS_DEFECT|' || "NOTIFICATIONID" AS NVARCHAR(150)) AS "EDGE_ID",
    CAST('CASE:' || "NOTIFICATIONID" AS NVARCHAR(150)) AS "SOURCE_ID",
    CAST('DC:' || "DEFECTCODE" AS NVARCHAR(150)) AS "TARGET_ID"
FROM "CNMA_PRORESOLVE_HISTORICALCASES"
WHERE "NOTIFICATIONID" IS NOT NULL AND "DEFECTCODE" IS NOT NULL
