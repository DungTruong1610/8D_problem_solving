VIEW "GRAPH_E_RESOLVED_BY" AS
SELECT
    CAST('RESOLVED_BY|' || a."ID" AS NVARCHAR(150)) AS "EDGE_ID",
    CAST('CASE:' || h."NOTIFICATIONID" AS NVARCHAR(150)) AS "SOURCE_ID",
    CAST('ACT:' || a."ID" AS NVARCHAR(150)) AS "TARGET_ID",
    CAST(a."ACTIONTYPE" AS NVARCHAR(30)) AS "ACTION_TYPE"
FROM "CNMA_PRORESOLVE_HISTORICALACTIONS" a
JOIN "CNMA_PRORESOLVE_HISTORICALCASES" h ON h."ID" = a."HISTORICALCASE_ID"
WHERE h."NOTIFICATIONID" IS NOT NULL
