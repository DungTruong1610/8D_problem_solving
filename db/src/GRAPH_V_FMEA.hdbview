VIEW "GRAPH_V_FMEA" AS
SELECT
    CAST('FMEA:' || "FMEAID" AS NVARCHAR(150)) AS "NODE_ID",
    CAST("FMEAID" AS NVARCHAR(30)) AS "BIZ_KEY",
    CAST(MAX("DESCR") AS NVARCHAR(255)) AS "TITLE"
FROM (
    SELECT "FMEAID", "DESCRIPTION" AS "DESCR" FROM "CNMA_PRORESOLVE_FMEAREGISTER" WHERE "FMEAID" IS NOT NULL
    UNION ALL
    SELECT "FMEAID", CAST(NULL AS NVARCHAR(255)) FROM "CNMA_PRORESOLVE_HISTORICALCASES" WHERE "FMEAID" IS NOT NULL
) AS "SRC"
GROUP BY "FMEAID"
