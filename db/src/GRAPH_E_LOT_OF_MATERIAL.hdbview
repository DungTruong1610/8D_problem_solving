VIEW "GRAPH_E_LOT_OF_MATERIAL" AS
SELECT
    CAST('LOT_OF_MATERIAL|' || "LOTID" || '#' || "CHARACTERISTIC" AS NVARCHAR(150)) AS "EDGE_ID",
    CAST('LOT:' || "LOTID" || '#' || "CHARACTERISTIC" AS NVARCHAR(150)) AS "SOURCE_ID",
    CAST('MAT:' || "MATERIALID" AS NVARCHAR(150)) AS "TARGET_ID"
FROM "CNMA_PRORESOLVE_INSPECTIONLOTS"
WHERE "LOTID" IS NOT NULL AND "CHARACTERISTIC" IS NOT NULL AND "MATERIALID" IS NOT NULL
