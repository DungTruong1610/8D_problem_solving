VIEW "GRAPH_E_LOT_AT" AS
SELECT
    CAST('LOT_AT|' || "LOTID" || '#' || "CHARACTERISTIC" AS NVARCHAR(150)) AS "EDGE_ID",
    CAST('LOT:' || "LOTID" || '#' || "CHARACTERISTIC" AS NVARCHAR(150)) AS "SOURCE_ID",
    CAST('WC:' || "WORKCENTERID" AS NVARCHAR(150)) AS "TARGET_ID"
FROM "CNMA_PRORESOLVE_INSPECTIONLOTS"
WHERE "LOTID" IS NOT NULL AND "CHARACTERISTIC" IS NOT NULL AND "WORKCENTERID" IS NOT NULL
