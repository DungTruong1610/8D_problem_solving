VIEW "GRAPH_V_CASE" AS
SELECT
    CAST('CASE:' || "NOTIFICATIONID" AS NVARCHAR(150)) AS "NODE_ID",
    CAST("NOTIFICATIONID" AS NVARCHAR(30)) AS "BIZ_KEY",
    CAST("SYMPTOMSHORTTEXT" AS NVARCHAR(255)) AS "TITLE",
    CAST("SAPSTATUS" AS NVARCHAR(30)) AS "SAP_STATUS",
    CAST(TO_VARCHAR("COMPLETIONDATE", 'YYYY-MM-DD') AS NVARCHAR(10)) AS "COMPLETED_ON",
    CAST(IFNULL("COPQEUR", 0) AS DOUBLE) AS "COPQ_EUR"
FROM "CNMA_PRORESOLVE_HISTORICALCASES"
WHERE "NOTIFICATIONID" IS NOT NULL
