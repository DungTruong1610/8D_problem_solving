VIEW "GRAPH_E_OCCURRED_AT" AS
SELECT
    CAST('OCCURRED_AT|' || "NOTIFICATIONID" AS NVARCHAR(150)) AS "EDGE_ID",
    CAST('CASE:' || "NOTIFICATIONID" AS NVARCHAR(150)) AS "SOURCE_ID",
    CAST('WC:' || "WORKCENTERID" AS NVARCHAR(150)) AS "TARGET_ID"
FROM "CNMA_PRORESOLVE_HISTORICALCASES"
WHERE "NOTIFICATIONID" IS NOT NULL AND "WORKCENTERID" IS NOT NULL
