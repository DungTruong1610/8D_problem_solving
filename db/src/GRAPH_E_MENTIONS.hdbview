VIEW "GRAPH_E_MENTIONS" AS
SELECT DISTINCT
    CAST('MENTIONS|' || "NID" || '|' || "TOKEN" AS NVARCHAR(150)) AS "EDGE_ID",
    CAST('CASE:' || "NID" AS NVARCHAR(150)) AS "SOURCE_ID",
    CAST('KW:' || "TOKEN" AS NVARCHAR(150)) AS "TARGET_ID"
FROM (
    SELECT h."NOTIFICATIONID" AS "NID", SUBSTR_REGEXPR('[^ ]+' IN h."SEARCHKEYWORDS" OCCURRENCE s."GENERATED_PERIOD_START") AS "TOKEN"
    FROM "CNMA_PRORESOLVE_HISTORICALCASES" h
    CROSS JOIN SERIES_GENERATE_INTEGER(1, 1, 61) s
    WHERE h."SEARCHKEYWORDS" IS NOT NULL
      AND SUBSTR_REGEXPR('[^ ]+' IN h."SEARCHKEYWORDS" OCCURRENCE s."GENERATED_PERIOD_START") IS NOT NULL
) AS "SRC"
